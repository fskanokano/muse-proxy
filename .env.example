# ===== muse-proxy 本地部署配置 (复制为 .env 后填写) =====

# 服务监听端口 (host 网络 0.0.0.0 监听, 公网面靠 ufw 挡:
# sudo ufw allow from 10.0.0.0/8 to any port 18091; 公网只走 sse-gateway 的 /mp 挂载)
MP_PORT=18091

# 客户端访问本服务的 API key (各门面的 PROXY_API_KEY 校验用;
# 经网关访问时还需同时在网关边缘 key 名单里加同一个 key)
#PROXY_API_KEY=

# 后台管理密码 (/admin/ 直接登录用, 子系统通道用内部钥时可空)
#MP_ADMIN_PASSWORD=
# 网关子系统内部钥 (与网关 MP_INTERNAL_KEY 同值; 为空则网关子系统通道关闭)
#MP_INTERNAL_KEY=
# goal 自动续轮上限 (0-1000, 缺省 1000; 0 = goal 模型与 muse 行为完全一致)
#MP_GOAL_MAX_ROUNDS=1000
