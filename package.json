{
  "name": "muse-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check supabase/functions/muse-proxy/index.ts supabase/functions/muse-proxy/router.ts scripts/serve-edge.ts scripts/fake-supabase.ts",
    "serve:edge": "deno run --allow-net --allow-env scripts/serve-edge.ts",
    "bundle:function": "deno bundle --platform deno --format esm --output supabase/.temp/muse-proxy-bundle.js supabase/functions/muse-proxy/index.ts",
    "serve:fake": "bun run bundle:function && deno run --allow-net --allow-env --allow-read scripts/fake-supabase.ts",
    "deploy:functions": "supabase functions deploy muse-proxy",
    "serve:functions": "supabase functions serve muse-proxy --env-file .env.local --no-verify-jwt",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:edge": "bun run scripts/smoke-edge.ts",
    "smoke:converse": "bun run scripts/smoke-converse.ts",
    "smoke:responses": "bun run scripts/smoke-responses.ts",
    "smoke:messages": "bun run scripts/smoke-messages.ts",
    "smoke:newmodels": "bun run scripts/smoke-newmodels.ts",
    "smoke:step5": "bun run scripts/smoke-step5.ts",
    "smoke:efforts": "bun run scripts/smoke-efforts.ts",
    "smoke:tools": "bun run scripts/smoke-agent-tools.ts",
    "smoke:openminis": "bun run scripts/probe-openminis-spacebunny.ts",
    "eval": "bun run scripts/agent-eval.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
